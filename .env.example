# API Keys
GOOGLE_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model Configuration
LLM_PROVIDER=gemini  # gemini or anthropic
MODEL_NAME=gemini-pro # or claude-3-sonnet-20240229
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CLASSIFIER_MODEL_PATH=models/classifier.pkl

# Vector Store
VECTOR_STORE_PATH=data/processed/faiss_index
KNOWLEDGE_BASE_PATH=data/raw/knowledge_base.json
TOP_K_RESULTS=3

# Generation Settings
MAX_TOKENS=500
TEMPERATURE=0.7
RESPONSE_LANGUAGE=en

# Database
DATABASE_URL=sqlite:///./smartticket.db

# API Settings
API_VERSION=v1
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Cache
ENABLE_CACHE=True
CACHE_TTL=3600
